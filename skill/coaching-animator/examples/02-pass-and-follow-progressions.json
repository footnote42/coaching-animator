        { "type": "setPass", "id": "p2", "from": "a2", "to": "a3", "at": 0 }
      ]
    },
    {
      "lever": "people",
      "commentary": {
        "points": [
          "A defender drifts across, so the last pass has to be decided, not assumed",
          "Look up before you release the ball"
        ]
      },
      "changes": [
        { "type": "addMarker", "marker": "d1", "cell": { "x": 13, "y": 2 } },
        { "type": "setMove", "marker": "d1", "waypoints": [{ "x": 16, "y": 4 }], "pace": "jog" }
