    ],
    "moves": [
      {
        "marker": "a1",
        "pace": "jog",
        "waypoints": [{ "x": 6, "y": 8, "hold": { "pass": "p1" } }, { "x": 6, "y": 11, "pace": "walk" }]
      },
      {
        "marker": "a2",
        "pace": "jog",
        "waypoints": [{ "x": 5, "y": 8, "hold": { "pass": "p2" } }, { "x": 4, "y": 11, "pace": "walk" }]
