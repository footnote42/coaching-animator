    { "id": "a9", "kind": "attacker", "label": "9" },
    { "id": "a10", "kind": "attacker", "label": "10" },
    { "id": "ball", "kind": "ball" },
    { "id": "shield1", "kind": "tackle-shield" },
    { "id": "d1", "kind": "defender", "label": "D1" }
  ],
  "base": {
    "placements": [
      { "marker": "a1", "cell": { "x": 6, "y": 12 } },
      { "marker": "a2", "cell": { "x": 4, "y": 12 } },
      { "marker": "a3", "cell": { "x": 8, "y": 12 } },
