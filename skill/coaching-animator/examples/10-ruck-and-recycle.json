  "progressions": [
    {
      "lever": "people",
      "commentary": {
        "points": [
          "A defender contests the ruck and holds there until 9 has the ball: supports must arrive first and stay over it",
          "Speed of arrival decides whether the ball is won cleanly"
        ]
      },
      "changes": [
        { "type": "addMarker", "marker": "d1", "cell": { "x": 6, "y": 2 } },
        {
          "type": "setMove",
          "marker": "d1",
          "pace": "jog",
          "waypoints": [{ "x": 6, "y": 6, "hold": { "pass": "p1" } }, { "x": 6, "y": 3, "pace": "walk" }]
        }
      ]
    },
    {
      "lever": "time",
      "commentary": {
        "points": [
          "2 and 3 now sprint to the ruck: beat the defender to the ball and clear them out",
          "Every second the ball stays on the floor is a second for the defence"
        ]
      },
      "changes": [
        {
          "type": "setMove",
          "marker": "a2",
          "pace": "sprint",
          "waypoints": [{ "x": 5, "y": 8, "hold": { "pass": "p2" } }, { "x": 4, "y": 11, "pace": "walk" }]
        },
        {
          "type": "setMove",
          "marker": "a3",
          "pace": "sprint",
          "waypoints": [{ "x": 7, "y": 8, "hold": { "pass": "p2" } }, { "x": 8, "y": 11, "pace": "walk" }]
